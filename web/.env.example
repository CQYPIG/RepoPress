# 开发模式下 vite dev server 将 /api 代理到的后端地址。
# 复制为 .env 并按需修改（.env 已被 git 忽略）。
VITE_API_TARGET=http://localhost:8000

# ── 反爬 / 防调试 ──────────────────────────────────────────────
# 总开关。留空 = 按环境自动（生产 VITE build 开启，开发 dev 关闭）。
# 也可显式设为 true / false。仅在开启时才应用下面各项。
# VITE_ANTI_DEBUG=true

# 是否禁用浏览器控制台（将 console.* 置为空操作并冻结 console）。
VITE_DISABLE_CONSOLE=true

# 是否禁用右键菜单。
VITE_DISABLE_CONTEXT_MENU=true

# 是否禁用开发者工具快捷键：F12、Ctrl/Cmd+Shift+I/J/C、Ctrl/Cmd+U。
VITE_DISABLE_DEVTOOLS=true

# 是否禁用文本选中与复制（注意：会影响编辑器的正常使用，默认关闭）。
VITE_DISABLE_SELECTION=false

# 注意：以上变量在构建时注入（import.meta.env），修改后需重启 dev server 或重新 build。
